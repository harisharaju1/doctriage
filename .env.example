NODE_ENV=development
PORT=3000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# POSTGRES_URL is required as of Week 2 Day 1 — the app now connects to
# Postgres/pgvector at startup and will refuse to boot without it.
#
# This value uses "localhost" because it's meant for running the app directly
# on your machine via `pnpm dev`, against Postgres's port published to the
# host (see docker-compose.yml's postgres service). When the app itself runs
# INSIDE Docker Compose (`docker compose up`), docker-compose.yml overrides
# this with the Docker service hostname ("postgres") instead — "localhost"
# inside a container means "this container", not the postgres container.
POSTGRES_URL=postgresql://doctriage:doctriage@localhost:5432/doctriage

AWS_ACCESS_KEY_ID=SAMPLE_KEY
AWS_SECRET_ACCESS_KEY=SAMPLE_KEY
AWS_REGION=ap-south-1
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# The LLM-as-judge model (Week 2 Day 5's eval harness) — a Bedrock CROSS-REGION
# INFERENCE PROFILE ID, not a bare foundation-model ID (Bedrock rejects
# on-demand invocation of several current Claude models by their plain model
# ID — see docs/week-2-day-3.md's "UPDATE" note). Has a default in
# src/config/env.ts, so this line is optional — included here for visibility.
AWS_BEDROCK_JUDGE_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Week 3 Day 2 — below this, POST /documents/:id/classify routes the result
# to the human review queue instead of trusting it automatically. Has a
# default (0.7) in src/config/env.ts; optional here.
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.7
